# Copy to .env.local and fill in values. .env.local is git-ignored.

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=shadowtrace        # the SQL files say "USE shadowtrace", so keep this name
MYSQL_USER=shadowtrace_app        # non-root application user (created by docker-compose)
MYSQL_PASSWORD=                   # choose a password for the app user
MYSQL_ROOT_PASSWORD=              # used only by docker-compose and `npm run db:reset`

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=shadowtrace

# --- Auth ---
JWT_SECRET=                       # random string, 32+ characters

# --- DEV ONLY: stub login used until real auth exists (see lib/auth.ts) ---
DEV_USER_ID=1
DEV_ROLE=ADMIN                    # ADMIN | INVESTIGATOR | ANALYST
