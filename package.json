{
  "name": "shadowtrace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker compose --env-file .env.local up -d",
    "db:down": "docker compose --env-file .env.local down",
    "db:init": "node --env-file=.env.local scripts/run-sql.mjs",
    "db:reset": "node --env-file=.env.local scripts/run-sql.mjs --reset",
    "mongo:setup": "node --env-file=.env.local db/mongo/evidence_artifacts.setup.ts",
    "mongo:seed": "node --env-file=.env.local db/mongo/evidence_artifacts.seed.ts",
    "mongo:pipelines": "node --env-file=.env.local db/mongo/evidence_artifacts.pipelines.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "jose": "^6.2.13",
    "mongodb": "^7.7.0",
    "mysql2": "^3.24.6",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
